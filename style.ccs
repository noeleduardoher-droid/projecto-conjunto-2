:root {
    --bg-header: #8B008B;
    --bg-main: #720041;
    --bg-aside: #f0f0f0;
    --text-color: #000;
}

body.dark-mode {
    --bg-header: #1a1a1a;
    --bg-main: #2b2b2b;
    --bg-aside: #333333;
    --text-color: #ffffff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Lucida Sans', sans-serif;
    background-color: #f0f0f0;
    overflow-x: hidden;
}

.header {
    background-color: var(--bg-header);
    width: 100%;
    height: 81px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    position: relative;
}

.pagename {
    font-family: "Jaro", sans-serif;
    font-weight: 700;
    font-style: italic;
    font-size: 30px;
}

.dark-mode-btn {
    position: absolute;
    right: 20px;
    padding: 8px 15px;
    cursor: pointer;
    border-radius: 20px;
    border: none;
    background: white;
    color: black;
    font-weight: bold;
}

.main-container {
    display: flex;
    min-height: calc(100vh - 81px);
}

.starlight {
    background-image: url("Textures/background.png");
    background-size: cover;
    background-color: var(--bg-aside);
    color: var(--text-color);
    width: 350px;
    padding: 20px;
    border-right: 5px solid black;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.side-menu {
    flex: 1;
    background-color: var(--bg-main);
    padding: 40px;
    transition: background-color 0.4s ease;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 25px;
    justify-items: center;
}

.book-item img {
    width: 100%;
    height: auto;
    border-radius: 5px;
    display: block;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.book-item:hover {
    transform: translateY(-10px);
    cursor: pointer;
}

.info-side-panel {
    position: fixed;
    top: 0;
    right: -400px;
    width: 400px;
    height: 100%;
    background-color: var(--bg-aside);
    color: var(--text-color);
    box-shadow: -5px 0 15px rgba(0,0,0,0.5);
    transition: right 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 3000;
    padding: 30px;
    display: flex;
    flex-direction: column;
    border-left: 2px solid #8B008B;
}

.info-side-panel.active {
    right: 0;
}

.close-panel-btn {
    align-self: flex-end;
    background: none;
    border: none;
    font-size: 45px;
    color: var(--text-color);
    cursor: pointer;
    line-height: 1;
}

.panel-body {
    text-align: center;
    margin-top: 20px;
}

#panel-img {
    width: 250px;
    border-radius: 10px;
    box-shadow: 0 8px 16px rgba(0,0,0,0.4);
    margin-bottom: 25px;
}

#panel-title {
    font-size: 26px;
    margin-bottom: 15px;
}

.read-now-btn {
    margin-top: 30px;
    padding: 15px;
    background-color: #8B008B;
    color: white;
    border: none;
    border-radius: 5px;
    font-weight: bold;
    width: 100%;
    cursor: pointer;
}

