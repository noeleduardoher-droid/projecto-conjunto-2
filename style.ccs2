@import url('https://fonts.googleapis.com/css2?family=Noto+Sans:wght@700&display=swap');

:root {
    --bg-header: #46b973;
    --bg-main: #720041;
    --bg-aside: #f0f0f0;
    --text-color: #000;
}

body.dark-mode {
    --bg-header: #1a1a1a;
    --bg-main: #2b2b2b;
    --bg-aside: #333333;
    --text-color: #ffffff;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Noto Sans', sans-serif;
  font-weight: 700;
  background-color: #f0f0f0;
  overflow-x: hidden;
}

.header {
    background-color: var(--bg-header);
    width: 100%;
    height: 81px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    position: relative;
    z-index: 100;
}

.dark-mode-btn {
    position: absolute;
    right: 20px;
    padding: 8px 15px;
    cursor: pointer;
    border-radius: 20px;
    border: none;
    transition: 0.3s;
}

.main-container {
  display: flex;
  min-height: calc(100vh - 81px);
}

.starlight {
    background-color: var(--bg-aside);
    width: 350px;
    padding: 20px;
    border-right: 5px solid black;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.starlight-logo-text {
  margin-top: 10px;
  font-size: 1.2rem;
}

.question {
  margin-top: 20px;
  font-size: 1rem;
}

.visit-link {
  color: #0066cc;
  text-decoration: none;
  margin-top: 10px;
}

.side-menu {
  flex: 1;
  background-color: var(--bg-main);
  padding: 40px;
}

.recomendation {
  color: white;
  margin-bottom: 20px;
  font-size: 2rem;
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 25px;
}

.book-item {
  position: relative;
  cursor: pointer;
  transition: 0.3s;
}

.book-item img {
  width: 100%;
  border-radius: 5px;
  height: 280px;
  object-fit: cover;
  box-shadow: 0 5px 15px rgba(0,0,0,0.3); }

.book-item:hover {
  transform: translateY(-10px);
}

.fav-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0,0,0,0.7);
    color: gold;
    border: 1px solid gold;
    border-radius: 50%;
    width: 35px;
    height: 35px;
    cursor: pointer;
    transition: 0.2s;
}

.info-side-panel {
    position: fixed;
    right: -100%;
    top: 0;
    width: 450px;
    height: 100vh;
    background: #1a1a1a;
    color: white;
    transition: 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 2000;
    padding: 25px;
    box-shadow: -10px 0 30px rgba(0,0,0,0.8);
    overflow-y: auto;
}

.info-side-panel.active {
  right: 0;
}

.close-panel-btn {
  background: #333;
  color: white;
  border: none;
  padding: 8px 15px;
  border-radius: 5px;
  cursor: pointer;
}

.panel-main-info {
  display: flex;
  gap: 20px;
  margin-top: 20px;
}

.panel-main-info img {
  width: 150px;
  height: 220px;
  object-fit: cover;
  border-radius: 8px;
}

.author-label {
  color: #aaa;
  margin: 10px 0;
}

.tabs-nav {
  display: flex;
  gap: 15px;
  margin: 20px 0;
  border-bottom: 1px solid #333;
}

.tab-link {
  background: none;
  border: none;
  color: #777;
  padding-bottom: 10px;
  cursor: pointer;
  font-weight: bold;
}

.tab-link.active {
  color: white; 
  border-bottom: 2px solid var(--bg-header);
}

.tab-content {
  display: none;
}

.tab-content.active {
  display: block;
}

.read-now-btn { 
    background: var(--bg-header);
    color: white;
    border: none; 
    padding: 12px 25px;
    border-radius: 5px;
    cursor: pointer;
    margin-top: 20px;
    font-weight: bold;
    width: 100%;
}

.reading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: black;
    z-index: 3000;
    display: flex;
    flex-direction: column;
}

.reading-nav { 
    display: flex;
    justify-content: space-between;
    padding: 15px; 
    background: #111;
    align-items: center;
    border-bottom: 1px solid #222;
}

.reader-controls {
  display: flex;
  gap: 10px;
}

.nav-reader-btn {
  background: var(--bg-header);
  color: white;
  border: none;
  padding: 8px 15px;
  border-radius: 5px;
  cursor: pointer;
  font-weight: bold;
}

.pdf-frame-container {
  flex-grow: 1;
  overflow: hidden;
  background: #000;
}

#pdf-viewer {
  width: 100%;
  height: calc(100% + 60px);
  margin-top: -60px;
}

.hidden {
  display: none !important;
}

.chapter-item {
    padding: 15px;
    background: #252525;
    margin-bottom: 8px;
    border-radius: 8px;
    cursor: pointer; 
    list-style: none; 
    display: flex; 
    gap: 15px;
}

.chapter-item span {
  color: var(--bg-header);
}

.chapter-item:hover {
  background: #333;
  transform: translateX(5px);
}

.main-footer {
    background-color: var(--bg-header);       color: white;
    padding: 25px;
    text-align: center;
    font-size: 0.9rem;
}

button:active {
  transform: scale(0.95);
}
